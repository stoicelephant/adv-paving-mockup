---
import { site } from "../../site";

interface Props {
  heading?: string;
}
const { heading = "Get a free quote." } = Astro.props;
---

<section aria-labelledby="cta-h" class="bg-paint text-asphalt">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-14 md:py-20 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
    <div>
      <h2 id="cta-h" class="display text-[clamp(2.8rem,6.5vw,5.4rem)]">{heading}</h2>
      <p class="mt-4 text-lg prose-width">Tell us about the property and what it needs. Commercial or residential, one driveway or a whole development.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
      <a href={`tel:${site.phone.tel}`} class="btn btn-asphalt text-lg min-h-14">Call {site.phone.display}</a>
      <a href="/contact" class="btn btn-outline min-h-14">Request a quote online</a>
    </div>
  </div>
</section>
