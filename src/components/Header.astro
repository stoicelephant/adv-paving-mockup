---
import { site } from "../site";
import { wixFit } from "../lib/wix";
---

<header class="sticky top-0 z-40 bg-slab/95 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.shortName}, home`}>
      <img
        src={wixFit(site.logo, 389, 227)}
        width="389"
        height="227"
        alt=""
        class="h-11 md:h-14 w-auto"
      />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 font-semibold">
        {site.nav.map((item) => <li><a class="py-2 hover:underline underline-offset-4 decoration-2" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${site.phone.tel}`} class="btn btn-asphalt hidden sm:inline-flex">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        {site.phone.display}
      </a>
      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer btn btn-outline min-h-11 px-4 [&::-webkit-details-marker]:hidden">Menu</summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-60 bg-slab border border-joint rounded-[3px] p-2 shadow-[0_10px_28px_-14px_rgb(32_35_38/0.45)]">
          <ul>
            {site.nav.map((item) => <li><a class="block px-3 py-3 rounded-[3px] font-semibold hover:bg-concrete" href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
  <!-- A painted line under the header: the only decorative use of yellow. -->
  <div class="h-1.5 bg-paint" aria-hidden="true"></div>
</header>
