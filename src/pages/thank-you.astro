---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`Request received | ${site.shortName}`} noindex leadPage>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-20 md:py-28">
    <h1 class="display text-[clamp(3rem,7vw,5rem)]">Thanks. We'll be in touch about your quote.</h1>
    <p class="mt-6 text-xl text-asphalt-soft">If it's urgent, call <a class="link font-semibold" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>.</p>
    {
      site.preview.enabled && (
        <p class="mt-10 rounded-[3px] bg-slab p-5 text-lg">
          This is a design preview, so nothing was sent. On the live site, each request goes straight to {site.email}.
        </p>
      )
    }
    <p class="mt-10"><a class="btn btn-outline" href="/">Back to the home page</a></p>
  </section>
</Base>
