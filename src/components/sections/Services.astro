---
import { site } from "../../site";
---

<section id="services" aria-labelledby="services-h" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-16 md:py-24">
  <h2 id="services-h" class="display text-[clamp(2.4rem,5vw,4.2rem)]">Services</h2>

  <ul class="mt-10 md:mt-12 border-b-2 border-asphalt">
    {
      site.services.map((s) => (
        <li class="border-t-2 border-asphalt py-6 md:py-8 grid gap-2 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-12 md:items-baseline">
          <h3 class="heading text-3xl md:text-4xl">
            <a href={`/services/${s.slug}`} class="hover:underline decoration-[3px] underline-offset-[6px]">{s.name}</a>
          </h3>
          <p class="text-lg text-asphalt-soft prose-width">{s.summary}</p>
        </li>
      ))
    }
  </ul>
</section>
