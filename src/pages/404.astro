---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`Page not found | ${site.shortName}`} noindex>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-20 md:py-28">
    <h1 class="display text-[clamp(3rem,7vw,5rem)]">That page moved or never existed.</h1>
    <p class="mt-6 text-xl text-asphalt-soft">Try the <a class="link" href="/">home page</a>, see <a class="link" href="/#services">our services</a>, or call <a class="link font-semibold" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>.</p>
  </section>
</Base>
