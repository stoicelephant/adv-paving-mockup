---
import { site } from "../site";
const year = new Date().getFullYear();
---

<footer class="on-dark bg-asphalt text-slab">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-14 grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="heading text-3xl">{site.name}</p>
      <p class="mt-3 text-slab/80">Based in {site.address.city}, Georgia. {site.license}. DUNS {site.duns}.</p>
      <p class="mt-7">
        <a class="display text-5xl md:text-6xl hover:text-paint" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
      </p>
      <p class="mt-3"><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div>
      <h2 class="font-bold">Services</h2>
      <ul class="mt-3 space-y-2">
        {site.services.map((s) => <li><a class="hover:underline underline-offset-4" href={`/services/${s.slug}`}>{s.name}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="font-bold">Talk to someone directly</h2>
      <ul class="mt-3 space-y-3">
        {
          site.team.map((p) => (
            <li>
              <span class="block text-slab/80">{p.name}</span>
              <a class="hover:underline underline-offset-4" href={`tel:${p.phone.tel}`}>{p.phone.display}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-slab/15">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-slab/70">
      <p>&copy; {year} {site.name}</p>
      <p><a class="hover:underline underline-offset-4" href="/team">About us</a></p>
      <p><a class="hover:underline underline-offset-4" href="/contact">Get a quote</a></p>
    </div>
  </div>
</footer>
