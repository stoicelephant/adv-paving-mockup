---
/** Structured data for the business, built from site.ts. No ratings: there are no published reviews yet. */
import { site } from "../site";

const sameAs = Object.values(site.social).filter(Boolean);
const data: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": site.schemaType,
  name: site.name,
  alternateName: "AAC",
  url: site.url,
  telephone: site.phone.tel,
  email: site.email,
  image: new URL(site.seo.ogImage, site.url).href,
  description: site.seo.description,
  foundingDate: String(site.foundedYear),
  duns: site.duns || undefined,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  sameAs: sameAs.length ? sameAs : undefined,
  employee: site.team.map((p) => ({ "@type": "Person", name: p.name, jobTitle: p.title, telephone: p.phone.tel, email: p.email })),
  makesOffer: site.services.map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.name, url: new URL(`/services/${s.slug}`, site.url).href },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
