---
import Base from "../layouts/Base.astro";
import RemotePhoto from "../components/RemotePhoto.astro";
import Cta from "../components/sections/Cta.astro";
import { site } from "../site";
---

<Base title={`Our team | ${site.shortName}`} description={`Meet the people behind ${site.shortName}: ${site.team.map((p) => p.name).join(", ")}. Paving in the Atlanta area since ${site.foundedYear}.`}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pt-10 md:pt-16 pb-14 md:pb-20 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:items-end">
    <div>
      <h1 class="display text-[clamp(3rem,7vw,6rem)]">Built on hard work, honesty and pride.</h1>
      <div class="mt-8 space-y-5 text-lg prose-width">
        {site.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <blockquote class="border-t-2 border-asphalt pt-6">
      <p class="heading text-[clamp(1.7rem,2.8vw,2.4rem)] leading-[1.12]">{site.mission}</p>
      <footer class="mt-4 text-asphalt-soft">Our mission</footer>
    </blockquote>
  </section>

  <section aria-label="Team members" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pb-16 md:pb-24">
    <ul class="space-y-16 md:space-y-24">
      {
        site.team.map((p, i) => (
          <li class="grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-14 md:items-center">
            <div class:list={["max-w-md", i % 2 === 1 && "md:order-2 md:justify-self-end"]}>
              <RemotePhoto photo={p.photo} alt={`${p.name}, ${p.title}`} ratio={4 / 5} align={p.crop ?? "c"} widths={[380, 560, 760]} sizes="(min-width: 768px) 40vw, 100vw" class="rounded-[3px]" />
            </div>
            <div class:list={[i % 2 === 1 && "md:order-1"]}>
              <h2 class="display text-[clamp(2.6rem,5vw,4.4rem)]">{p.name}</h2>
              <p class="mt-2 text-xl text-asphalt-soft">{p.title}{p.area && `, ${p.area}`}</p>
              <div class="mt-6 space-y-4 text-lg prose-width">
                {p.bio.map((b) => <p>{b}</p>)}
              </div>
              <dl class="mt-7 grid gap-x-10 gap-y-3 sm:grid-cols-[auto_1fr]">
                <dt class="text-asphalt-soft">Direct line</dt>
                <dd><a class="link font-semibold" href={`tel:${p.phone.tel}`}>{p.phone.display}</a></dd>
                <dt class="text-asphalt-soft">Email</dt>
                <dd><a class="link font-semibold break-all" href={`mailto:${p.email}`}>{p.email}</a></dd>
              </dl>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="how-h" class="bg-slab">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-16 md:py-24">
      <h2 id="how-h" class="display text-[clamp(2.4rem,5vw,4.2rem)]">How we work</h2>
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
        {
          site.howWeWork.map((h) => (
            <li class="border-t-2 border-asphalt pt-5">
              <h3 class="heading text-3xl">{h.title}</h3>
              <p class="mt-3 text-lg text-asphalt-soft prose-width">{h.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-14 heading text-[clamp(1.6rem,2.6vw,2.2rem)]">What we stand on: {site.values.slice(0, -1).join(", ").toLowerCase()} and {site.values[site.values.length - 1].toLowerCase()}.</p>
    </div>
  </section>

  <Cta />
</Base>
