---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../site";
---

<Base title={`Get a free quote | ${site.shortName}`} description={`Call ${site.phone.display} or send a few details for a free paving, concrete, seal coating or striping quote.`}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pt-10 md:pt-16 pb-16 md:pb-24 grid gap-12 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
    <div>
      <h1 class="display text-[clamp(3rem,7vw,5.6rem)]">Get a free quote</h1>
      <p class="mt-6 text-lg text-asphalt-soft prose-width">Tell us about the property and what it needs. We'll get back to you to talk it through and set up a time to see it.</p>
      <p class="mt-8">
        <a href={`tel:${site.phone.tel}`} class="display text-5xl md:text-6xl hover:underline decoration-paint decoration-4 underline-offset-8">{site.phone.display}</a>
      </p>
      <p class="mt-3"><a class="link text-lg" href={`mailto:${site.email}`}>{site.email}</a></p>

      <h2 class="heading mt-12 text-2xl">Or call someone directly</h2>
      <ul class="mt-4 border-b-2 border-asphalt">
        {
          site.team.map((p) => (
            <li class="border-t-2 border-asphalt py-3.5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <span><span class="font-semibold">{p.name}</span> <span class="text-asphalt-soft">{p.title}</span></span>
              <a class="link font-semibold" href={`tel:${p.phone.tel}`}>{p.phone.display}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-asphalt-soft">{site.license}. DUNS {site.duns}. Based in {site.address.city}, Georgia.</p>
    </div>

    <div class="rounded-[3px] bg-slab p-5 sm:p-8 lg:p-10 self-start">
      <ContactForm />
    </div>
  </section>
</Base>
