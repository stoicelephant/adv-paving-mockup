---
import { site } from "../../site";
const list = site.projectTypes;
const sentence = list.slice(0, -1).join(", ") + " and " + list[list.length - 1];
---

<section aria-labelledby="who-h" class="bg-slab">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-16 md:py-24 grid gap-8 lg:grid-cols-[1fr_2.2fr] lg:gap-14">
    <h2 id="who-h" class="display text-[clamp(2.4rem,5vw,4.2rem)]">Who we pave for</h2>
    <div>
      <p class="heading text-[clamp(1.8rem,3.4vw,2.9rem)] leading-[1.12] text-asphalt">
        {sentence.charAt(0).toUpperCase() + sentence.slice(1)}.
      </p>
      <p class="mt-6 text-lg text-asphalt-soft prose-width">Commercial or residential. New builds or renovations. Small jobs to large-scale sites.</p>
    </div>
  </div>
</section>
