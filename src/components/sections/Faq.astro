---
import { site } from "../../site";

interface Props {
  items?: { q: string; a: string }[];
  title?: string;
}
const { items = site.faqs, title = "Common questions" } = Astro.props;

const faqJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});
---

<section aria-labelledby="faq-h" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pb-16 md:pb-24 grid gap-8 lg:grid-cols-[1fr_2.2fr] lg:gap-14">
  <h2 id="faq-h" class="display text-[clamp(2.4rem,5vw,4.2rem)]">{title}</h2>
  <div class="border-b-2 border-asphalt">
    {
      items.map((f) => (
        <details class="group border-t-2 border-asphalt">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-xl font-semibold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span aria-hidden="true" class="text-3xl leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="pb-6 text-lg text-asphalt-soft prose-width">{f.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={faqJson} />
</section>
