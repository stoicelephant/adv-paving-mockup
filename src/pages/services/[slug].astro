---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/sections/Cta.astro";
import { site, type Service } from "../../site";

export function getStaticPaths() {
  return site.services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const others = site.services.filter((s) => s.slug !== service.slug);
const isAda = service.slug === "striping-ada";
---

<Base title={`${service.name} | ${site.shortName}`} description={`${service.summary} ${site.shortName}, Brookhaven GA. Free quotes: ${site.phone.display}.`}>
  <article class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pt-10 md:pt-16 pb-16 md:pb-24">
    <nav aria-label="Breadcrumb" class="text-asphalt-soft">
      <a class="link" href="/#services">Services</a>
    </nav>

    <div class="mt-4 grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <div>
        <h1 class="display text-[clamp(3rem,7vw,6rem)]">{service.name}</h1>
        <div class:list={["mt-6 h-2 w-28", isAda ? "bg-ada" : "bg-paint"]} aria-hidden="true"></div>
        <div class="mt-8 space-y-5 text-xl prose-width">
          {service.body.map((p) => <p>{p}</p>)}
        </div>

        <h2 class="heading mt-14 text-3xl">What it covers</h2>
        <ul class="mt-5 border-b-2 border-asphalt">
          {service.includes.map((item) => <li class="border-t-2 border-asphalt py-4 text-lg">{item}</li>)}
        </ul>
      </div>

      <aside class="space-y-10">
        <div class="rounded-[3px] bg-slab p-6 md:p-8">
          <h2 class="heading text-3xl">Get a quote for {service.name.toLowerCase()}</h2>
          <p class="mt-3 text-asphalt-soft">Free, for commercial and residential properties.</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href={`tel:${site.phone.tel}`} class="btn btn-paint text-lg min-h-14">Call {site.phone.display}</a>
            <a href="/contact" class="btn btn-outline min-h-14">Request a quote online</a>
          </div>
          <p class="mt-6 text-sm text-asphalt-soft">{site.license}. DUNS {site.duns}.</p>
        </div>
        <div>
          <h2 class="heading text-2xl">Other services</h2>
          <ul class="mt-3 space-y-2 text-lg">
            {others.map((s) => <li><a class="link font-semibold" href={`/services/${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </article>
  <Cta />
</Base>
